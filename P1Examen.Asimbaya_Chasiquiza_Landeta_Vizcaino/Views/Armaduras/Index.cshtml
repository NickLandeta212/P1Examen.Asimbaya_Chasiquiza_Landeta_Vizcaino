@model IEnumerable<ExamenP1.Asimbaya_Chasiquiza_Landeta_Vizcaino.Models.Armadura>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Caballeros.caballeroName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.nombreArmadura)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.tipoArmadura)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.resistencia)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Caballeros.caballeroName)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.nombreArmadura)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.tipoArmadura)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.resistencia)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.Id }) |
            @Html.ActionLink("Details", "Details", new { id=item.Id }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.Id })
        </td>
    </tr>
}

</table>
